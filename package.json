{
  "name": "russian-revolution-documentary",
  "version": "1.0.0",
  "private": true,
  "description": "الثورة الروسية 1917: عشرة أيام هزّت العالم — Remotion documentary",
  "scripts": {
    "start": "remotion studio",
    "check:assets": "node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit",
    "render": "REMOTION_FAST=1 remotion render RussianRevolution720 out/documentary.mp4 --codec=h264 --video-bitrate=450K --audio-bitrate=96K --x264-preset=slow --concurrency=100%",
    "render:fast": "REMOTION_FAST=1 remotion render RussianRevolution720 out/documentary_720p.mp4 --codec=h264 --video-bitrate=450K --audio-bitrate=96K --x264-preset=slow --concurrency=100%",
    "render:test": "remotion render RussianRevolution out/test.mp4 --codec=h264 --crf=23 --frames=0-899 --concurrency=100%"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}